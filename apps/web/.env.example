# API base URL (NestJS backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# PWA (Progressive Web App) - Developer controlled toggle
# true  -> installable app + service worker (offline support)
# false/unset -> plain website, PWA disabled
NEXT_PUBLIC_PWA_ENABLED=false

# CAPTCHA (Cloudflare Turnstile) - Optional and free
# https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both empty to disable CAPTCHA completely (checks are skipped)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
