// HAS ERP - Prisma Schema
// Modern web-based ERP / inventory / sales / accounting management system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ORGANIZATION / TENANT ABSTRACTION
// The ERP is designed so that a future multi-business / SaaS
// tenancy layer can be added without a breaking migration.
// A single-row Organization table anchors all business data.
// ============================================================

model Organization {
  id                String    @id @default(cuid())
  name              String
  shortName         String?
  code              String    @unique
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users             User[]
  roles             Role[]
  headAccounts      HeadAccount[]
  subHeads          SubHead[]
  mainAccounts      MainAccount[]
  itemTypes         ItemType[]
  brands            Brand[]
  items             Item[]
  stockLocations    StockLocation[]
  towns             Town[]
  customers         Customer[]
  suppliers         Supplier[]
  vouchers          Voucher[]
  purchases         Purchase[]
  purchaseReturns   PurchaseReturn[]
  stockTransfers    StockTransfer[]
  sales             Sale[]
  salesReturns      SalesReturn[]
  inventoryTransactions InventoryTransaction[]
  paymentEntries  PaymentEntry[]
  bankAccounts    BankAccount[]
  auditLogs         AuditLog[]
  systemSettings    SystemSetting[]
  brandingSettings  BrandingSetting[]
  departments       Department[]
  designations      Designation[]
  employees         Employee[]
  leaveTypes        HrLeaveType[]
  leaveRequests     HrLeaveRequest[]
  attendance        HrAttendance[]
  payrollRuns       PayrollRun[]
  salaryComponents  SalaryComponent[]
  employeeSalaryComponents EmployeeSalaryComponent[]
  employeeLoans     EmployeeLoan[]
  employeeSalaryRecords EmployeeSalaryRecord[]
}

// ============================================================
// USER MANAGEMENT
// ============================================================

model User {
  id           String    @id @default(cuid())
  fullName     String
  username     String    @unique
  email        String?   @unique
  phone        String?
  passwordHash String
  status       String    @default("active") // active | inactive | suspended
  lastLoginAt  DateTime?
  tokenVersion Int       @default(1) // bumped to revoke all refresh tokens
  failedLoginAttempts Int @default(0)
  lockedUntil  DateTime? // brute-force lockout window
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String? // encrypted TOTP base32 secret
  twoFactorRecoveryCodes Json? // sha256 hashes of unused recovery codes
  organizationId String @default("default-org")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  roles        UserRole[]
  auditLogs    AuditLog[]
  createdVouchers   Voucher[]      @relation("CreatedVouchers")
  createdPurchases  Purchase[]     @relation("CreatedPurchases")
  createdSales      Sale[]         @relation("CreatedSales")
  createdTransfers  StockTransfer[] @relation("CreatedTransfers")

  @@index([organizationId])
  @@index([status])
}

model Role {
    id             String   @id @default(cuid())
    name           String
    description    String?
    isSystem       Boolean  @default(false)
    protected      Boolean  @default(false)
    organizationId String   @default("default-org")
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([name, organizationId])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // MODULE.ACTION e.g. "administration.items.create"
  description String?
  module      String
  action      String
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String   @default("default-org")
  action         String   // e.g. "CREATE", "UPDATE", "POST", "CANCEL", "LOGIN"
  module         String   // e.g. "SALES", "INVENTORY", "ACCOUNTING"
  entity         String?  // e.g. "Sale"
  entityId       String?
  message        String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([module, action])
  @@index([userId])
}

// ============================================================
// ACCOUNTING - MAIN ACCOUNT SETUP
// Head Account > Sub Head > Main Account
// ============================================================

model HeadAccount {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  status         String   @default("active") // active | inactive
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  subHeads     SubHead[]

  @@unique([code, organizationId])
  @@index([organizationId])
}

model SubHead {
  id             String   @id @default(cuid())
  code           String
  name           String
  description    String?
  status         String   @default("active")
  headAccountId  String
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id])
  headAccount   HeadAccount   @relation(fields: [headAccountId], references: [id], onDelete: Restrict)
  mainAccounts  MainAccount[]

  @@unique([code, headAccountId])
  @@index([headAccountId])
  @@index([organizationId])
}

model MainAccount {
  id             String       @id @default(cuid())
  code           String
  name           String
  accountType    String       // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  description    String?
  subHeadId      String?
  openingBalance Decimal      @default(0) @db.Decimal(18, 2)
  openingBalanceType String    @default("DR") // DR | CR
  openingDate    DateTime?
  status         String       @default("active")
  organizationId String       @default("default-org")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  subHead      SubHead?      @relation(fields: [subHeadId], references: [id], onDelete: Restrict)
  voucherEntries VoucherEntry[]
  customers      Customer[]
  suppliers      Supplier[]
  paymentEntries PaymentEntry[]
  bankAccounts   BankAccount[]
  employees      Employee[]
  pdcCustomers   Customer[]      @relation("PartyPdcAccount")
  pdcSuppliers   Supplier[]      @relation("PartyPdcAccount")
  pdcPaymentEntries PaymentEntry[] @relation("PaymentPdcAccount")
  salaryExpenseDepartments Department[] @relation("DepartmentSalaryExpenseAccount")

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([accountType])
}

// ============================================================
// PRODUCT MASTER DATA
// ============================================================

model ItemType {
  id             String   @id @default(cuid())
  name           String
  description    String?
  status         String   @default("active")
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  items        Item[]

  @@unique([name, organizationId])
}

model Brand {
  id             String   @id @default(cuid())
  name           String
  description    String?
  status         String   @default("active")
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  items        Item[]

  @@unique([name, organizationId])
}

model Item {
  id               String   @id @default(cuid())
  code             String   @unique
  barcode          String?  @unique
  name             String
  unit             String   @default("pcs")
  purchasePrice    Decimal  @default(0) @db.Decimal(18, 2)
  salePrice        Decimal  @default(0) @db.Decimal(18, 2)
  /// Running weighted-average cost of the units on hand, maintained whenever
  /// stock comes in at a cost. This is what cost of goods sold is valued at;
  /// `purchasePrice` is only the latest quoted price and is not a cost basis.
  averageCost      Decimal  @default(0) @db.Decimal(18, 2)
  minStockLevel    Decimal  @default(0) @db.Decimal(18, 2)
  description      String?
  status           String   @default("active")
  itemTypeId       String?
  brandId          String?
  defaultLocationId String?
  organizationId   String   @default("default-org")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization?   @relation(fields: [organizationId], references: [id])
  itemType       ItemType?       @relation(fields: [itemTypeId], references: [id], onDelete: SetNull)
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  defaultLocation StockLocation? @relation(fields: [defaultLocationId], references: [id])
  inventoryTransactions InventoryTransaction[]
  purchaseItems        PurchaseItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  saleItems            SaleItem[]
  salesReturnItems     SalesReturnItem[]
  transferItems        StockTransferItem[]

  @@index([name])
  @@index([status])
  @@index([itemTypeId])
  @@index([brandId])
}

model StockLocation {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  status         String   @default("active")
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  items        Item[]
  inventoryTransactions InventoryTransaction[]
  purchases    Purchase[]
  purchaseReturns PurchaseReturn[]
  sales        Sale[]
  salesReturns SalesReturn[]
  transferFrom StockTransfer[] @relation("TransferFrom")
  transferTo   StockTransfer[] @relation("TransferTo")

  @@unique([code, organizationId])
}

// ============================================================
// PARTY MASTER DATA
// ============================================================

model Town {
  id             String   @id @default(cuid())
  name           String
  city           String?
  description    String?
  status         String   @default("active")
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  customers    Customer[]
  suppliers    Supplier[]

  @@unique([name, organizationId])
}

model Customer {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  phone          String?
  address        String?
  townId         String?
  mainAccountId  String?
  pdcAccountId   String?
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  creditLimit    Decimal  @default(0) @db.Decimal(18, 2)
  creditDays     Int      @default(30)
  description    String?
  status         String   @default("active")
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  town         Town?         @relation(fields: [townId], references: [id], onDelete: SetNull)
  mainAccount  MainAccount?  @relation(fields: [mainAccountId], references: [id], onDelete: SetNull)
  pdcAccount   MainAccount?  @relation("PartyPdcAccount", fields: [pdcAccountId], references: [id], onDelete: SetNull)
  sales        Sale[]
  salesReturns SalesReturn[]

  @@unique([code, organizationId])
  @@index([name])
}

model Supplier {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  phone          String?
  address        String?
  townId         String?
  mainAccountId  String?
  pdcAccountId   String?
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  description    String?
  status         String   @default("active")
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  town         Town?         @relation(fields: [townId], references: [id], onDelete: SetNull)
  mainAccount  MainAccount?  @relation(fields: [mainAccountId], references: [id], onDelete: SetNull)
  pdcAccount   MainAccount?  @relation("PartyPdcAccount", fields: [pdcAccountId], references: [id], onDelete: SetNull)
  purchases    Purchase[]
  purchaseReturns PurchaseReturn[]

  @@unique([code, organizationId])
  @@index([name])
}

// ============================================================
// ACCOUNTING - VOUCHERS & LEDGER
// ============================================================

model Voucher {
  id             String   @id @default(cuid())
  number         String   @unique
  voucherType    String   // JOURNAL | CREDIT | DEBIT
  voucherDate    DateTime @default(now())
  reference      String?
  description    String?
  status         String   @default("draft") // draft | pending | posted | cancelled
  totalDebit     Decimal  @default(0) @db.Decimal(18, 2)
  totalCredit    Decimal  @default(0) @db.Decimal(18, 2)
  postedById     String?
  postedAt       DateTime?
  submittedById  String?
  submittedAt    DateTime?
  rejectedById   String?
  rejectedAt     DateTime?
  rejectReason   String?
  cancelledAt    DateTime?
  cancelReason   String?
  cancelledBy    String?
  createdById    String?
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id])
  createdBy     User?         @relation("CreatedVouchers", fields: [createdById], references: [id], onDelete: SetNull)
  entries       VoucherEntry[]

  @@unique([number, organizationId])
  @@index([voucherDate])
  @@index([status])
  @@index([voucherType])
}

model VoucherEntry {
  id        String   @id @default(cuid())
  voucherId String
  mainAccountId String
  debit     Decimal  @default(0) @db.Decimal(18, 2)
  credit    Decimal  @default(0) @db.Decimal(18, 2)
  narration String?

  voucher     Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  mainAccount MainAccount @relation(fields: [mainAccountId], references: [id])

  @@index([mainAccountId])
  @@index([voucherId])
}

// ============================================================
// INVENTORY - PURCHASE
// ============================================================

model Purchase {
  id              String   @id @default(cuid())
  number          String   @unique
  purchaseDate    DateTime @default(now())
  reference       String?
  note            String?
  supplierId      String
  stockLocationId String
  subtotal        Decimal  @default(0) @db.Decimal(18, 2)
  discount        Decimal  @default(0) @db.Decimal(18, 2)
  tax             Decimal  @default(0) @db.Decimal(18, 2)
  commission      Decimal  @default(0) @db.Decimal(18, 2)
  grandTotal      Decimal  @default(0) @db.Decimal(18, 2)
  payStatus       String   @default("unpaid") // paid | partial | unpaid
  paidAmount      Decimal  @default(0) @db.Decimal(18, 2)
  status          String   @default("draft") // draft | pending | posted | cancelled
  postedById      String?
  postedAt        DateTime?
  submittedById   String?
  submittedAt     DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectReason    String?
  cancelledAt     DateTime?
  cancelReason    String?
  createdById     String?
  organizationId  String   @default("default-org")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization     Organization?      @relation(fields: [organizationId], references: [id])
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  stockLocation    StockLocation     @relation(fields: [stockLocationId], references: [id])
  createdBy        User?             @relation("CreatedPurchases", fields: [createdById], references: [id], onDelete: SetNull)
  items            PurchaseItem[]
  purchaseReturns  PurchaseReturn[]

  @@unique([number, organizationId])
  @@index([purchaseDate])
  @@index([status])
  @@index([supplierId])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  itemId     String
  quantity   Decimal  @default(0) @db.Decimal(18, 2)
  unitCost   Decimal  @default(0) @db.Decimal(18, 2)
  discount   Decimal  @default(0) @db.Decimal(18, 2)
  tax        Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal  Decimal  @default(0) @db.Decimal(18, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@index([itemId])
}

model PurchaseReturn {
  id              String   @id @default(cuid())
  number          String   @unique
  returnDate      DateTime @default(now())
  reference       String?
  note            String?
  purchaseId      String?
  supplierId      String
  stockLocationId String
  subtotal        Decimal  @default(0) @db.Decimal(18, 2)
  discount        Decimal  @default(0) @db.Decimal(18, 2)
  tax             Decimal  @default(0) @db.Decimal(18, 2)
  grandTotal      Decimal  @default(0) @db.Decimal(18, 2)
  status          String   @default("draft") // draft | pending | posted | cancelled
  submittedById   String?
  submittedAt     DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectReason    String?
  createdById     String?
  organizationId  String   @default("default-org")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization     Organization?     @relation(fields: [organizationId], references: [id])
  purchase         Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  stockLocation    StockLocation     @relation(fields: [stockLocationId], references: [id])
  items            PurchaseReturnItem[]

  @@unique([number, organizationId])
  @@index([returnDate])
  @@index([status])
}

model PurchaseReturnItem {
  id                String   @id @default(cuid())
  purchaseReturnId  String
  itemId            String
  quantity          Decimal  @default(0) @db.Decimal(18, 2)
  unitCost          Decimal  @default(0) @db.Decimal(18, 2)
  discount          Decimal  @default(0) @db.Decimal(18, 2)
  tax               Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal         Decimal  @default(0) @db.Decimal(18, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  item           Item           @relation(fields: [itemId], references: [id])

  @@index([itemId])
}

// ============================================================
// INVENTORY - SALE
// ============================================================

model Sale {
  id              String    @id @default(cuid())
  number          String    @unique
  saleDate        DateTime  @default(now())
  dueDate         DateTime?
  reference       String?
  note            String?
  customerId      String
  stockLocationId String
  subtotal        Decimal   @default(0) @db.Decimal(18, 2)
  discount        Decimal   @default(0) @db.Decimal(18, 2)
  tax             Decimal   @default(0) @db.Decimal(18, 2)
  commission      Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal      Decimal   @default(0) @db.Decimal(18, 2)
  paymentStatus   String    @default("unpaid") // paid | partial | unpaid
  amountPaid      Decimal   @default(0) @db.Decimal(18, 2)
  status          String    @default("draft") // draft | pending | posted | cancelled
  postedById      String?
  postedAt        DateTime?
  submittedById   String?
  submittedAt     DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectReason    String?
  cancelledAt     DateTime?
  cancelReason    String?
  createdById     String?
  organizationId  String    @default("default-org")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization     Organization?      @relation(fields: [organizationId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  stockLocation    StockLocation     @relation(fields: [stockLocationId], references: [id])
  createdBy        User?             @relation("CreatedSales", fields: [createdById], references: [id], onDelete: SetNull)
  items            SaleItem[]
  salesReturns     SalesReturn[]

  @@unique([number, organizationId])
  @@index([saleDate])
  @@index([status])
  @@index([customerId])
}

model SaleItem {
  id       String   @id @default(cuid())
  saleId   String
  itemId   String
  quantity Decimal  @default(0) @db.Decimal(18, 2)
  unitPrice Decimal @default(0) @db.Decimal(18, 2)
  discount Decimal  @default(0) @db.Decimal(18, 2)
  tax      Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal Decimal @default(0) @db.Decimal(18, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId])
}

model SalesReturn {
  id              String   @id @default(cuid())
  number          String   @unique
  returnDate      DateTime @default(now())
  reference       String?
  note            String?
  saleId          String?
  customerId      String
  stockLocationId String
  subtotal        Decimal  @default(0) @db.Decimal(18, 2)
  discount        Decimal  @default(0) @db.Decimal(18, 2)
  tax             Decimal  @default(0) @db.Decimal(18, 2)
  grandTotal      Decimal  @default(0) @db.Decimal(18, 2)
  status          String   @default("draft") // draft | pending | posted | cancelled
  submittedById   String?
  submittedAt     DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectReason    String?
  createdById     String?
  organizationId  String   @default("default-org")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization     Organization?      @relation(fields: [organizationId], references: [id])
  sale             Sale?              @relation(fields: [saleId], references: [id], onDelete: SetNull)
  customer         Customer          @relation(fields: [customerId], references: [id])
  stockLocation    StockLocation     @relation(fields: [stockLocationId], references: [id])
  items            SalesReturnItem[]

  @@unique([number, organizationId])
  @@index([returnDate])
  @@index([status])
}

model SalesReturnItem {
  id             String   @id @default(cuid())
  salesReturnId  String
  itemId         String
  quantity       Decimal  @default(0) @db.Decimal(18, 2)
  unitPrice      Decimal  @default(0) @db.Decimal(18, 2)
  discount       Decimal  @default(0) @db.Decimal(18, 2)
  tax            Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(18, 2)

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  item        Item        @relation(fields: [itemId], references: [id])

  @@index([itemId])
}

// ============================================================
// INVENTORY - STOCK TRANSFER
// ============================================================

model StockTransfer {
  id             String   @id @default(cuid())
  number         String   @unique
  transferDate   DateTime @default(now())
  fromLocationId String
  toLocationId   String
  note           String?
  status         String   @default("draft") // draft | pending | posted | cancelled
  submittedById  String?
  submittedAt    DateTime?
  rejectedById   String?
  rejectedAt     DateTime?
  rejectReason   String?
  createdById    String?
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?        @relation(fields: [organizationId], references: [id])
  fromLocation StockLocation       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   StockLocation       @relation("TransferTo", fields: [toLocationId], references: [id])
  createdBy    User?               @relation("CreatedTransfers", fields: [createdById], references: [id], onDelete: SetNull)
  items        StockTransferItem[]

  @@unique([number, organizationId])
  @@index([transferDate])
  @@index([status])
}

model StockTransferItem {
  id              String   @id @default(cuid())
  stockTransferId String
  itemId          String
  quantity        Decimal  @default(0) @db.Decimal(18, 2)

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])

  @@index([itemId])
}

// ============================================================
// INVENTORY TRANSACTION LEDGER
// Type: OPENING_STOCK | PURCHASE | PURCHASE_RETURN | SALE |
//       SALES_RETURN | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT
// ============================================================

model InventoryTransaction {
  id             String   @id @default(cuid())
  itemId         String
  locationId     String
  transactionType String
  referenceType  String?
  referenceId    String?
  quantityIn     Decimal  @default(0) @db.Decimal(18, 2)
  quantityOut    Decimal  @default(0) @db.Decimal(18, 2)
  balance        Decimal  @default(0) @db.Decimal(18, 2)
  unitCost       Decimal? @db.Decimal(18, 2)
  createdById    String?
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  item         Item         @relation(fields: [itemId], references: [id])
  location     StockLocation @relation(fields: [locationId], references: [id])

  @@index([itemId, locationId, createdAt])
  @@index([transactionType])
  @@index([referenceType, referenceId])
}

// ============================================================
// RECEIPTS & PAYMENTS
// paymentType: RECEIPT | PAYMENT
// method: CASH | CHEQUE | BANK
// ============================================================

model PaymentEntry {
  id             String   @id @default(cuid())
  number         String
  paymentType    String   // RECEIPT | PAYMENT
  partyType      String   // CUSTOMER | SUPPLIER
  partyId        String
  partyName      String?
  mainAccountId  String   // cash / bank account receiving or disbursing
  method         String   @default("CASH") // CASH | CHEQUE | BANK
  chequeNumber   String?
  bankAccountId  String?
  pdcAccountId   String?
  chequeDate     DateTime? // maturity / clearing date for post-dated cheques
  chequeStatus   String?  // PENDING | IN_HAND | DEPOSITED | BOUNCED | ENDORSED
  amount         Decimal  @default(0) @db.Decimal(18, 2)
  paymentDate    DateTime @default(now())
  reference      String?
  narration      String?
  status         String   @default("pending") // pending | posted | cancelled
  voucherId      String?
  postedById     String?
  postedAt       DateTime?
  depositedById  String?
  depositedAt    DateTime?
  bouncedById    String?
  bouncedAt      DateTime?
  bounceReason   String?
  rejectedById   String?
  rejectedAt     DateTime?
  rejectReason   String?
  cancelledById  String?
  cancelledAt    DateTime?
  cancelReason   String?
  createdById    String?
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?   @relation(fields: [organizationId], references: [id])
  mainAccount  MainAccount     @relation(fields: [mainAccountId], references: [id])
  bankAccount  BankAccount?    @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  pdcAccount   MainAccount?    @relation("PaymentPdcAccount", fields: [pdcAccountId], references: [id], onDelete: SetNull)
  allocations  PaymentAllocation[]

  @@unique([number, organizationId])
  @@index([paymentType, paymentDate])
  @@index([partyId])
  @@index([status])
  @@index([mainAccountId])
  @@index([bankAccountId])
  @@index([pdcAccountId])
  @@index([chequeStatus])
}

model BankAccount {
  id             String   @id @default(cuid())
  name           String
  accountTitle   String?
  accountNumber  String?
  mainAccountId  String?  // linked bank main account used when cheques clear
  status         String   @default("active")
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id])
  mainAccount    MainAccount?  @relation(fields: [mainAccountId], references: [id], onDelete: SetNull)
  paymentEntries PaymentEntry[]

  @@unique([name, organizationId])
}

model PaymentAllocation {
  id              String   @id @default(cuid())
  paymentEntryId  String
  documentType    String   // SALE | SALES_RETURN | PURCHASE | PURCHASE_RETURN
  documentId      String
  allocatedAmount Decimal  @default(0) @db.Decimal(18, 2)

  paymentEntry PaymentEntry @relation(fields: [paymentEntryId], references: [id], onDelete: Cascade)

  @@index([documentType, documentId])
  @@index([paymentEntryId])
}

// ============================================================
// SYSTEM
// ============================================================

model SystemSetting {
  id             String   @id @default(cuid())
  key            String
  value          String?
  description    String?
  organizationId String   @default("default-org")
  updatedAt      DateTime @updatedAt
  updatedById    String?

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([key, organizationId])
}

model BrandingSetting {
  id             String   @id @default(cuid())
  businessName   String   @default("HAS ERP")
  shortName      String   @default("HAS")
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String   @default("#2563eb")
  secondaryColor String   @default("#0f172a")
  address        String?
  phone          String?
  email          String?
  ntn            String?
  invoiceFooter  String?
  invoiceTerms   String?
  reportFooter   String?
  saleFooter     String?
  saleTerms      String?
  purchaseFooter String?
  purchaseTerms  String?
  salesReturnFooter  String?
  salesReturnTerms   String?
  purchaseReturnFooter String?
  purchaseReturnTerms  String?
  organizationId String   @default("default-org")
  updatedAt      DateTime @updatedAt
  updatedById    String?

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId])
}

// ============================================================
// HUMAN RESOURCES & PAYROLL
// ============================================================

model Department {
  id                    String       @id @default(cuid())
  code                  String       @unique
  name                  String
  description           String?
  salaryExpenseAccountId String?
  status                String       @default("active")
  organizationId        String       @default("default-org")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  organization         Organization? @relation(fields: [organizationId], references: [id])
  salaryExpenseAccount MainAccount?  @relation("DepartmentSalaryExpenseAccount", fields: [salaryExpenseAccountId], references: [id], onDelete: SetNull)
  designations         Designation[]
  employees            Employee[]

  @@unique([code, organizationId])
  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([salaryExpenseAccountId])
}

model Designation {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  departmentId   String?
  status         String   @default("active")
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees    Employee[]

  @@unique([code, organizationId])
  @@unique([name, organizationId])
  @@index([departmentId])
}

model Employee {
  id             String   @id @default(cuid())
  code           String   @unique
  fullName       String
  fatherName     String?
  cnic           String?
  phone          String?
  email          String?
  address        String?
  departmentId   String?
  designationId  String?
  joinDate       DateTime @default(now())
  employmentType String   @default("permanent") // permanent | contract | daily
  basicSalary    Decimal  @default(0) @db.Decimal(18, 2)
  allowance      Decimal  @default(0) @db.Decimal(18, 2)
  status         String   @default("active") // active | inactive | terminated
  exitDate       DateTime?
  exitReason     String?
  bankName       String?
  bankAccount    String?
  mainAccountId  String?
  description    String?
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization?               @relation(fields: [organizationId], references: [id])
  department       Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      Designation?                @relation(fields: [designationId], references: [id], onDelete: SetNull)
  attendance       HrAttendance[]
  leaveRequests    HrLeaveRequest[]
  payrollItems     PayrollItem[]
  salaryComponents EmployeeSalaryComponent[]
  loans            EmployeeLoan[]
  salaryHistory    EmployeeSalaryRecord[]
  mainAccount      MainAccount?                @relation(fields: [mainAccountId], references: [id], onDelete: SetNull)

  @@unique([code, organizationId])
  @@index([fullName])
  @@index([departmentId])
  @@index([status])
}

model SalaryComponent {
  id             String   @id @default(cuid())
  name           String
  type           String   @default("EARNING") // EARNING | DEDUCTION
  calcType       String   @default("FIXED") // FIXED | PERCENT_BASIC
  value          Decimal  @default(0) @db.Decimal(18, 2)
  status         String   @default("active")
  sortOrder      Int      @default(0)
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?              @relation(fields: [organizationId], references: [id])
  employeeLinks   EmployeeSalaryComponent[]

  @@unique([name, organizationId])
  @@index([type, status])
}

model EmployeeSalaryComponent {
  id             String   @id @default(cuid())
  employeeId     String
  componentId    String
  amount         Decimal  @default(0) @db.Decimal(18, 2) // fixed amount OR percent x basic for PERCENT_BASIC
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  employee  Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  component SalaryComponent  @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([employeeId, componentId])
  @@index([componentId])
}

model EmployeeLoan {
  id             String   @id @default(cuid())
  employeeId     String
  amount         Decimal  @default(0) @db.Decimal(18, 2)
  installment    Decimal  @default(0) @db.Decimal(18, 2)
  startMonth     Int
  startYear      Int
  paidAmount     Decimal  @default(0) @db.Decimal(18, 2)
  status         String   @default("active") // active | paid | cancelled
  note           String?
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
}

model EmployeeSalaryRecord {
  id           String   @id @default(cuid())
  employeeId   String
  basicSalary  Decimal  @default(0) @db.Decimal(18, 2)
  allowance    Decimal  @default(0) @db.Decimal(18, 2)
  effectiveDate DateTime @default(now())
  note         String?
  createdById  String?
  organizationId String @default("default-org")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model HrLeaveType {
  id             String   @id @default(cuid())
  name           String
  paid           Boolean  @default(true)
  annualQuota    Int      @default(0)
  description    String?
  status         String   @default("active")
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id])
  requests     HrLeaveRequest[]

  @@unique([name, organizationId])
}

model HrLeaveRequest {
  id             String   @id @default(cuid())
  employeeId     String
  leaveTypeId    String
  fromDate       DateTime
  toDate         DateTime
  days           Decimal  @default(1) @db.Decimal(6, 2)
  reason         String?
  status         String   @default("pending") // pending | approved | rejected
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    HrLeaveType   @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([fromDate])
}

model HrAttendance {
  id             String   @id @default(cuid())
  employeeId     String
  date           DateTime
  status         String   @default("present") // present | absent | leave | half_day | holiday
  overtimeHours  Decimal  @default(0) @db.Decimal(6, 2)
  note           String?
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
}

model PayrollRun {
  id             String   @id @default(cuid())
  number         String   @unique
  periodMonth    Int
  periodYear     Int
  payDate        DateTime @default(now())
  totalGross     Decimal  @default(0) @db.Decimal(18, 2)
  totalDeduction Decimal  @default(0) @db.Decimal(18, 2)
  totalNet       Decimal  @default(0) @db.Decimal(18, 2)
  status         String   @default("draft") // draft | posted | cancelled
  voucherId      String?
  disbursementVoucherId String?
  paidAt         DateTime?
  note           String?
  postedById     String?
  postedAt       DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  organizationId String   @default("default-org")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  items        PayrollItem[]

  @@unique([number, organizationId])
  @@index([periodYear, periodMonth])
  @@index([status])
}

model PayrollItem {
  id              String   @id @default(cuid())
  payrollRunId    String
  employeeId      String
  basic           Decimal  @default(0) @db.Decimal(18, 2)
  allowance       Decimal  @default(0) @db.Decimal(18, 2)
  overtimeHours   Decimal  @default(0) @db.Decimal(6, 2)
  overtimeAmount  Decimal  @default(0) @db.Decimal(18, 2)
  absentDays      Decimal  @default(0) @db.Decimal(6, 2)
  absentDeduction Decimal  @default(0) @db.Decimal(18, 2)
  otherDeduction  Decimal  @default(0) @db.Decimal(18, 2)
  taxDeduction    Decimal  @default(0) @db.Decimal(18, 2)
  grossPay        Decimal  @default(0) @db.Decimal(18, 2)
  totalDeduction  Decimal  @default(0) @db.Decimal(18, 2)
  netPay          Decimal  @default(0) @db.Decimal(18, 2)
  componentBreakdown Json?

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}