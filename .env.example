# Database (Neon serverless PostgreSQL)
# Replace with your Neon pooled connection string from the Neon dashboard:
#   Database -> Connection Details -> Pooler (Prisma) -> "Connection string"
DATABASE_URL="postgresql://user:pass@ep-xxx-abc.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# JWT — MUST be long random strings (min ~32 chars), and MUST differ from each
# other. The API refuses to start in production when these are the default values.
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin(s) allowed to call this API (comma-separated, no trailing slash)
WEB_URL=http://localhost:3000

# Reverse proxy — set to 1 (trust first hop) or true when deploying behind a
# proxy/load balancer so rate limiting and account lockout see real client IPs.
# TRUST_PROXY=false

# There is no admin bootstrap env var. The first admin comes from the seed:
#   pnpm db:seed        -> developer / Developer@123  (Developer, Super Admin)
#                           admin     / Admin@123      (Super Admin)
# Run it once per environment, then change the passwords. Re-running it is safe:
# existing passwords are never overwritten.

# Note: the chart of accounts is deliberately NOT seeded. Every company creates
# its own head / sub-head / main accounts, then binds each role the posting
# engine needs in Settings > Accounting (Cash, Accounts Receivable, Inventory,
# Sales Revenue, Cost of Sales, ...). Sales, purchases, returns, payroll and
# cheque postings stay blocked until those roles are mapped.
